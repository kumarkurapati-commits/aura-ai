rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can only read and write their own projects, chats and settings.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && collection in ['projects', 'chats', 'settings'];
    }

    // Shared chats: anyone with the link can read; only the owner can create, update or delete.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }
  }
}
